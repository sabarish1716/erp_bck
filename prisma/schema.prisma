generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        Role     @default(STUDENT)

  // Optional link to student
  studentId   String?  @unique
  student     Student? @relation(fields: [studentId], references: [id])

  isActive    Boolean  @default(true)
  staffId     String?  @unique
  // Document issue relations
  docRequestsMade    DocRequest[] @relation("DocRequestedBy")
  docRequestsReviewed DocRequest[] @relation("DocReviewedBy")
  docRequestsIssued  DocRequest[] @relation("DocIssuedBy")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

}

enum Role {
  ADMIN
  PRINCIPAL
  STAFF
  TRANSPORT_MANAGER
  TEACHER
  STUDENT
}

enum SyncJobType {
  LOCATION
  MILEAGE
  DRIVER_STATUS
  FUEL_LOG
}

enum SyncJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}



enum Gender {
  MALE
  FEMALE
}

enum Community {
  SC
  ST
  SCA
  MBC
  BC
  OBC
  BCM
  OTHERS
}

enum Standard {
  LKG
  UKG
  STD_1
  STD_2
  STD_3
  STD_4
  STD_5
  STD_6
  STD_7
  STD_8
  STD_9
  STD_10
  STD_11
  STD_12
}

enum AcademicStream {
  BIO_MATHS        // Physics, Chemistry, Maths, Biology
  CS_MATHS         // Physics, Chemistry, Maths, Computer Science
  BIO_CS           // Physics, Chemistry, Biology, Computer Science
  COMMERCE         // Commerce, Economics, Accountancy, Computer Application
}

enum StaffCategory {
  TEACHING_REGULAR
  TEACHING_TRAINEE
  NON_TEACHING_REGULAR
  NON_TEACHING_TRAINEE
}

enum StaffDocumentType {
  EXPERIENCE_CERTIFICATE
  RELIEVING_LETTER
  APPOINTMENT_LETTER
  SALARY_SLIP
  EDUCATION_CERTIFICATE
  ID_PROOF
  ADDRESS_PROOF
  MEDICAL_CERTIFICATE
  OTHER
}

enum DiscountType {
  FLAT
  PERCENTAGE
  TEACHER_DISCOUNT    // Staff child discount
  SIBLING_DISCOUNT    // Sibling studying in same school
  RTE_COMMUNITY       // RTE / community-based discount (SC/ST/MBC etc.)
}

model Student {
  id                String   @id @default(uuid())
  name              String
  standard          Standard
  gender            Gender
  dob               DateTime
  religion          String?
  customCommunity   String? // For "Others" option in
  community         Community
  caste             String?
  motherTongue      String?
  aadharNo          String?
  bloodGroup        String?
  identification1   String?
  identification2   String?
  previousSchool    String?
  transportMode     String? // Local / Van
  rte               Boolean @default(false)

  // Section & Academic Year
  section           String?  @default("A")// e.g. "A", "B", "C"
  academicYear      String?  // e.g. "2026-2027"

  // 11th/12th higher secondary stream selection
  academicStream    AcademicStream?

  // Discount-related links
  staffParentId     String?  // If parent is a staff member → teacher discount
  staffParent       Staff?   @relation("StaffChildren", fields: [staffParentId], references: [id])
  siblingGroupId    String?  // Group ID to link siblings → sibling discount

  // House assignment
  houseId           String?
  house             House?   @relation("HouseStudents", fields: [houseId], references: [id])

  // Relations
  family            Family?
  address           Address?
  admission         Admission?
  documents         Document[]
  academics         AcademicDetail[]
  users             User?
  studentFees       StudentFee[]
  studentTransport  StudentTransport?
  docRequests       DocRequest[]
  houseCaptain      House?   @relation("HouseCaptain")
  houseViceCaptain  House?   @relation("HouseViceCaptain")
  houseBandCaptain  House?   @relation("HouseBandCaptain")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  documentsJson     Json?
}

model Family {
  id           String  @id @default(uuid())
  studentId    String  @unique

  fatherName   String?
  fatherPhone  String?
  fatherWhatsapp String?
  fatherAadhar String?
  fatherOccupation String?
  preferredPhone String?
  parentsEmail String?

  motherName   String?
  motherPhone  String?
  motherWhatsapp String?
  motherAadhar String?
  motherOccupation String?

  // Single parent support
  isSingleParent    Boolean @default(false)
  guardianName      String?
  guardianPhone     String?
  guardianWhatsapp  String?
  guardianAadhar    String?
  guardianOccupation String?
  guardianRelation  String?   // e.g. "father", "mother", "grandfather"

  // Sibling 1 details
  sibling1Name      String?
  sibling1Standard  String?
  sibling1School    String?   // "Same School" or school name

  // Sibling 2 details
  sibling2Name      String?
  sibling2Standard  String?
  sibling2School    String?   // "Same School" or school name

  siblingSchool   String?
  otherSchoolName String?

  otherWhatsapp String?
  familyIncome  Float?
  siblings      String?
  hostelRequired Boolean @default(false)

  student      Student @relation(fields: [studentId], references: [id])
}

model Address {
  id        String @id @default(uuid())
  studentId String @unique
  doorNo    String?
  street    String?
  landmark  String?
  city      String?
  state     String?
  line1     String
  line2     String?
  line3     String?
  pin       String

  student   Student @relation(fields: [studentId], references: [id])
}

model AcademicDetail {
  id                 String @id @default(uuid())
  studentId          String

  examName           String?   // e.g. "SSLC", "MATRIC", "CBSE"
  boardName          String?   @default("State Board") // "State Board" or custom board name
  registerNo         String?
  monthYear          String?   // e.g. "March 2024"

  // TOTAL row from the qualifying exam table
  totalMaxMarks      Int?      // sum of Maximum Marks Prescribed
  totalObtainedMarks Int?      // sum of Marks Obtained
  totalPercentage    Float?    // overall % (top-right of form)

  stream             AcademicStream?

  subjects           SubjectMark[]

  student            Student @relation(fields: [studentId], references: [id])
}

model SubjectMark {
  id              String @id @default(uuid())
  academicId      String

  subjectName     String
  maxMarks        Int
  obtainedMarks   Int
  percentage      Float

  academic        AcademicDetail @relation(fields: [academicId], references: [id])
}

model Document {
  id              String @id @default(uuid())
  studentId       String

  // ✅ Checkbox status (from form)
  photo           Boolean @default(false)
  birthCert       Boolean @default(false)
  communityCert   Boolean @default(false)
  aadharFather    Boolean @default(false)
  aadharMother    Boolean @default(false)
  aadharStudent   Boolean @default(false)
  transferCert    Boolean @default(false)

  // ✅ Hard-copy flags (physical document received, not digitised)
  photoHardCopy         Boolean @default(false)
  birthCertHardCopy     Boolean @default(false)
  communityCertHardCopy Boolean @default(false)
  aadharFatherHardCopy  Boolean @default(false)
  aadharMotherHardCopy  Boolean @default(false)
  aadharStudentHardCopy Boolean @default(false)
  transferCertHardCopy  Boolean @default(false)

  // ✅ 3 photos received checkbox
  photosReceived        Boolean @default(false)

  // ✅ Actual uploaded file paths
  photoPath         String?
  birthCertPath     String?
  communityCertPath String?
  aadharFatherPath  String?
  aadharMotherPath  String?
  aadharStudentPath String?
  transferCertPath  String?

  student         Student @relation(fields: [studentId], references: [id])
}
model Admission {
  id                  String   @id @default(uuid())
  studentId           String   @unique

  admissionNo         String
  admissionDate       DateTime
  admissionFrom       DateTime?
  admissionTo         DateTime?
  standard            Standard

  staffSignature      String?   // uploaded file path
  principalSignature  String?   // must be added later by principal

  isApproved          Boolean   @default(false) // ✅ ADD THIS
  approvedAt          DateTime?
  approvedByRole      Role?
  approvedByEmail     String?
  approvalNote        String?

  student             Student   @relation(fields: [studentId], references: [id])
}

model AppSetting {
  id             String   @id @default(uuid())
  key            String   @unique
  value          Json
  updatedByEmail String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ═══════════════════════════════════════════════
// PHONEPE PAYMENT LINKS
// ═══════════════════════════════════════════════

model PaymentLink {
  id                    String     @id @default(uuid())
  studentFeeId          String

  amount                Float
  phoneNumber           String
  channel               String     // SMS / WHATSAPP

  merchantTransactionId String     @unique
  phonePeUrl            String?

  // PENDING / SUCCESS / FAILED / EXPIRED
  status                String     @default("PENDING")

  // Linked Payment once webhook confirms success
  paymentId             String?

  notificationSent      Boolean    @default(false)
  notificationError     String?

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  studentFee            StudentFee @relation(fields: [studentFeeId], references: [id])
}




