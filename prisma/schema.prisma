model Staff {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  name          String
  email         String   @unique
  phone         String?
  designation   String   // e.g. "Teacher", "HOD", "Principal", "Clerk"
  department    String?  // e.g. "Mathematics", "Science", "Administration"
  qualification String?
  joiningDate   DateTime?
  salary        Float?
  isActive      Boolean  @default(true)

  // Category & payment
  category      StaffCategory @default(TEACHING_REGULAR)
  paymentMode   String?   // CASH / BANK_TRANSFER
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?
  pfJoiningDate DateTime? // Date when PF started
  city          String?
  area String?
  pincode String?
  doorno String?
  state String?

  // Link to children studying here (for teacher discount)
  children      Student[] @relation("StaffChildren")

  // HR relations
  attendances         Attendance[]
  leaveApplications   LeaveApplication[]
  permissionRequests  PermissionRequest[]
  staffStatutory      StaffStatutory?
  payrollRecords      Payroll[]
  esslMapping         ESSLStaffMapping?
  advances            StaffAdvance[]

  // POS relations
  teacherFreeItems    TeacherFreeItem[]

  // Staff document records
  documents           StaffDocument[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StaffDocument {
  id              String            @id @default(uuid())
  staffId         String
  type            StaffDocumentType @default(OTHER)
  title           String
  filePath        String
  originalName    String
  mimeType        String
  sizeBytes       Int
  description     String?
  documentNumber  String?
  issuedDate      DateTime?
  expiryDate      DateTime?
  isVerified      Boolean           @default(false)
  uploadedAt      DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  staff           Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, type])
  @@index([uploadedAt])
}


model Driver {
  id         String   @id @default(uuid())
  name       String
  email      String?  @unique
  phone      String?
  deviceId   String?
  busId      String?
  licenseNo  String?
  address    String?
  bloodGroup String?
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  bus        Bus?     @relation(fields: [busId], references: [id])
  locations  Location[]
  mileages   Mileage[] @relation("DriverMileages")
  fuelLogs   FuelLog[] @relation("DriverFuelLogs")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())
}

model Bus {
  id          String   @id @default(uuid())
  number      String   // e.g. TN-01-1234
  routeName   String?
  routeId     String?
  capacity    Int?
  drivers     Driver[]
  locations   Location[]
  mileages    Mileage[] @relation("BusMileages")
  fuelLogs    FuelLog[] @relation("BusFuelLogs")
  route       TransportRoute? @relation("RouteBuses", fields: [routeId], references: [id])
  createdAt   DateTime @default(now())
}

model Location {
  id        String   @id @default(uuid())
  driverId  String
  busId     String
  latitude  Float
  longitude Float
  speed     Float?
  createdAt DateTime

  driver Driver @relation(fields: [driverId], references: [id])
  bus    Bus    @relation(fields: [busId], references: [id])

  @@index([driverId])
  @@index([busId])
  @@index([createdAt])

  // prevent duplicates during retry sync
  @@unique([driverId, createdAt])
}

model SupabaseSyncJob {
  id          String        @id @default(uuid())
  type        SyncJobType
  status      SyncJobStatus @default(PENDING)
  dedupeKey   String?       @unique
  payload     Json
  attempts    Int           @default(0)
  lastError   String?
  availableAt DateTime      @default(now())
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, availableAt])
  @@index([type, status])
}

model Mileage {
  id          String   @id @default(uuid())
  busId       String
  driverId    String
  odometer    Float
  snapshotTime DateTime @default(now())

  bus         Bus      @relation("BusMileages", fields: [busId], references: [id])
  driver      Driver   @relation("DriverMileages", fields: [driverId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([busId])
  @@index([driverId])
  @@index([snapshotTime])
}

model VehicleTripLog {
  id         String   @id @default(uuid())
  plateNo    String
  deviceId   String
  event      String   // IGNITION_ON, IGNITION_OFF
  driverName String?
  latitude   Float?
  longitude  Float?
  speed      Float?
  odometer   Float?
  timestamp  DateTime @default(now())

  @@index([plateNo, timestamp])
  @@index([deviceId, timestamp])
  @@index([event])
}

model FuelLog {
  id           String   @id @default(uuid())
  driverId     String
  busId        String?
  plateNo      String?
  odometer     Float
  litres       Float
  fuelCostPerLitre Float?
  totalCost    Float?
  note         String?
  imageUrl     String?
  timestamp    DateTime @default(now())

  driver       Driver   @relation("DriverFuelLogs", fields: [driverId], references: [id])
  bus          Bus?     @relation("BusFuelLogs", fields: [busId], references: [id])

  createdAt    DateTime @default(now())

  @@index([driverId])
  @@index([busId])
  @@index([plateNo, timestamp])
}

model FeeStructure {
  id           String   @id @default(uuid())
  standard     Standard
  academicYear String

  tuitionFee   Float
  transportFee Float   @default(0)
  bookFee      Float   @default(0)
  hostelFee    Float   @default(0)
  otherFee     Float   @default(0)

  numberOfTerms Int    @default(1)  // 1, 2, or 3

  customItems  CustomFeeItem[]
  terms        FeeTermTemplate[]
  kitItems     FeeKitItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([standard, academicYear])
}

// Kit items mapped from POS to a fee structure's book/kit fee
model FeeKitItem {
  id              String       @id @default(uuid())
  feeStructureId  String
  storeItemId     String
  quantity        Int          @default(1)
  amount          Float        // price for this kit item (qty × unit price)

  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  storeItem       StoreItem    @relation(fields: [storeItemId], references: [id])

  createdAt       DateTime     @default(now())
}

// Term-wise breakdown template (auto-generated from structure)
model FeeTermTemplate {
  id              String       @id @default(uuid())
  feeStructureId  String
  termNumber      Int          // 1, 2, 3
  termName        String       // "Term 1", "Term 2", etc.
  dueDate         DateTime?
  amount          Float        // portion of total for this term

  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

model StudentFee {
  id            String   @id @default(uuid())
  studentId     String
  academicYear  String

  tuitionFee    Float   @default(0)
  transportFee  Float   @default(0)
  bookFee       Float   @default(0)
  hostelFee     Float   @default(0)
  otherFee      Float   @default(0)

  totalFee      Float
  discount      Float   @default(0)
  netFee        Float

  numberOfTerms Int     @default(1)

  // Kit tracking: kitAmount is total of kit items issued from POS
  kitAmount     Float   @default(0)
  bookBalance   Float   @default(0)  // bookFee - kitAmount

  student       Student @relation(fields: [studentId], references: [id])
  payments      Payment[]
  discounts     Discount[]
  customItems   StudentCustomFeeItem[]
  terms         StudentFeeTerm[]
  paymentLinks  PaymentLink[]
  kitIssues     StudentKitIssue[]

  @@unique([studentId, academicYear])
}

// Kit items actually issued to a student against their book/kit fee
model StudentKitIssue {
  id            String     @id @default(uuid())
  studentFeeId  String
  storeItemId   String
  quantity      Int        @default(1)
  amount        Float      // actual amount charged for this item
  issuedDate    DateTime   @default(now())
  saleId        String?    // linked POS sale if applicable

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  storeItem     StoreItem  @relation(fields: [storeItemId], references: [id])

  createdAt     DateTime   @default(now())
}

// Term-wise breakdown per student
model StudentFeeTerm {
  id            String     @id @default(uuid())
  studentFeeId  String
  termNumber    Int        // 1, 2, 3
  termName      String     // "Term 1", "Term 2"
  amount        Float      // how much is due this term (total)
  dueDate       DateTime?
  status        String     @default("PENDING") // PENDING / PARTIAL / PAID

  // Component-wise breakdown per term
  tuitionAmount    Float   @default(0)
  transportAmount  Float   @default(0)
  bookAmount       Float   @default(0)
  hostelAmount     Float   @default(0)
  otherAmount      Float   @default(0)

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
}


model Payment {
  id            String   @id @default(uuid())
  studentFeeId  String

  amount        Float
  paymentDate   DateTime @default(now())
  paymentMode   String   // CASH / UPI / BANK
  receiptNo     String?
  remarks       String?
  termNumber    Int?     // which term this payment is for (null = general)
  status        String   @default("SUCCESS")
  statusReason  String?
  refundAmount  Float?
  receiptComponents Json?
  paidComponents    Json?    // { tuition: 17333, transport: 3667, book: 1667, ... }

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id])

  createdAt     DateTime @default(now())
}


model Discount {
  id            String       @id @default(uuid())
  studentFeeId  String

  type          DiscountType // FLAT / PERCENTAGE / TEACHER_DISCOUNT / SIBLING_DISCOUNT / RTE_COMMUNITY
  value         Float
  reason        String?

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id])
}

// Custom fee items on the FeeStructure template (e.g. Lab Fee for a standard)
model CustomFeeItem {
  id              String       @id @default(uuid())
  feeStructureId  String
  name            String       // e.g. "Lab Fee", "Sports Fee"
  amount          Float

  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

// Custom fee items assigned to a specific student
model StudentCustomFeeItem {
  id            String     @id @default(uuid())
  studentFeeId  String
  name          String     // e.g. "Lab Fee", "Special Coaching"
  amount        Float

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════
// TRANSPORT MANAGEMENT
// ═══════════════════════════════════════════════

model TransportRoute {
  id            String   @id @default(uuid())
  routeName     String   // e.g. "Route A - Velachery"
  routeNo       String?  @unique
  baseFee       Float    // normal fee for this route
  splClassFee   Float    @default(0) // additional surcharge for special/spl class
  description   String?

  // Conductor info
  conductorName  String?
  conductorPhone String?

  stops         TransportStop[]
  students      StudentTransport[]
  buses         Bus[]     @relation("RouteBuses")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TransportStop {
  id            String         @id @default(uuid())
  routeId       String
  stopName      String         // e.g. "Tambaram", "Chrompet"
  stopOrder     Int            // order of stop on route
  distanceKm    Float?
  pickupTime    String?        // e.g. "07:30 AM"
  dropTime      String?        // e.g. "04:15 PM"
  fee           Float?         // optional per-stop fee override

  route         TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students      StudentTransport[]
}

// Student → Route assignment
model StudentTransport {
  id            String         @id @default(uuid())
  studentId     String         @unique
  routeId       String
  busno         String?        // optional override if student is on a different bus than the route's main bus
  stopId        String?
  academicYear  String
  isSplClass    Boolean        @default(false) // if true, charge splClassFee extra

  // Special class date tracking for pro-rata calculation
  splClassStartDate  DateTime?   // when student started using spl class transport
  splClassEndDate    DateTime?   // when student stopped (null = still active)
  splClassDaysUsed   Int?        // actual number of days student used spl class transport
  totalWorkingDays   Int?        // total working days in the period for pro-rata calc

  student       Student        @relation(fields: [studentId], references: [id])
  route         TransportRoute @relation(fields: [routeId], references: [id])
  stop          TransportStop? @relation(fields: [stopId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════════
// HOUSE MANAGEMENT
// ═══════════════════════════════════════════════

model House {
  id              String   @id @default(uuid())
  name            String   @unique  // e.g. "Red House", "Blue House"
  colorCode       String?           // hex color e.g. "#FF0000"
  motto           String?

  captainId       String?  @unique
  viceCaptainId   String?  @unique
  bandCaptainId   String?  @unique

  captain         Student? @relation("HouseCaptain", fields: [captainId], references: [id])
  viceCaptain     Student? @relation("HouseViceCaptain", fields: [viceCaptainId], references: [id])
  bandCaptain     Student? @relation("HouseBandCaptain", fields: [bandCaptainId], references: [id])

  students        Student[] @relation("HouseStudents")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════
// ─── HR MODULE ────────────────────────────────
// ═══════════════════════════════════════════════

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum PunchMethod {
  FINGERPRINT
  FACE
  CARD
  PIN
  MANUAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Attendance {
  id            String           @id @default(uuid())
  staffId       String
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  checkIn       String?
  checkOut      String?
  punchMethod   PunchMethod?
  workingHours  Float?
  remarks       String?
  isESSLSync    Boolean          @default(false)

  staff         Staff            @relation(fields: [staffId], references: [id])

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([staffId, date])
  @@index([date])
}

model LeaveType {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  maxPerYear    Int      @default(12)
  carryForward  Boolean  @default(false)
  isActive      Boolean  @default(true)

  applications  LeaveApplication[]
  balances      LeaveBalance[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LeaveBalance {
  id            String    @id @default(uuid())
  staffId       String
  leaveTypeId   String
  year          String
  total         Float     @default(0)
  used          Float     @default(0)
  remaining     Float     @default(0)

  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([staffId, leaveTypeId, year])
}

model LeaveApplication {
  id            String      @id @default(uuid())
  staffId       String
  leaveTypeId   String
  fromDate      DateTime    @db.Date
  toDate        DateTime    @db.Date
  days          Float
  halfDay       Boolean     @default(false)
  reason        String
  status        LeaveStatus @default(PENDING)
  approvedBy    String?
  rejectedBy    String?
  rejectionNote String?

  staff         Staff       @relation(fields: [staffId], references: [id])
  leaveType     LeaveType   @relation(fields: [leaveTypeId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([staffId])
  @@index([status])
}

model PermissionRequest {
  id            String      @id @default(uuid())
  staffId       String
  date          DateTime    @db.Date
  fromTime      String
  toTime        String
  hours         Float
  reason        String
  status        LeaveStatus @default(PENDING)
  approvedBy    String?
  rejectedBy    String?
  rejectionNote String?

  staff         Staff       @relation(fields: [staffId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([staffId])
  @@index([date])
}

model StatutorySettings {
  id              String   @id @default(uuid())
  pfEnabled       Boolean  @default(true)
  pfEmployeeRate  Float    @default(12)
  pfEmployerRate  Float    @default(12)
  pfWageLimit     Float    @default(15000)
  pfAdminCharges  Float    @default(0.5)
  pfEdliCharges   Float    @default(0.5)
  esiEnabled      Boolean  @default(true)
  esiEmployeeRate Float    @default(0.75)
  esiEmployerRate Float    @default(3.25)
  esiWageLimit    Float    @default(21000)
  ptEnabled       Boolean  @default(false)
  ptAmount        Float    @default(200)

  updatedAt       DateTime @updatedAt
}

model StaffStatutory {
  id            String   @id @default(uuid())
  staffId       String   @unique
  pfNumber      String?
  uanNumber     String?
  esiNumber     String?
  basicSalary   Float?
  grossSalary   Float?
  pfEnabled     Boolean  @default(true)
  esiEnabled    Boolean  @default(true)

  staff         Staff    @relation(fields: [staffId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ESSLDevice {
  id            String   @id @default(uuid())
  name          String
  ipAddress     String
  port          Int      @default(4370)
  serialNumber  String?
  deviceType    String   @default("fingerprint")
  location      String?
  isOnline      Boolean  @default(false)
  lastSyncAt    DateTime?

  punchLogs     ESSLPunchLog[]
  staffMappings ESSLStaffMapping[]
  syncHistory   ESSLSyncHistory[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ESSLPunchLog {
  id            String       @id @default(uuid())
  deviceId      String
  staffId       String?
  employeeId    String?
  punchTime     DateTime
  punchType     String?
  punchMethod   PunchMethod?
  verified      Boolean      @default(true)

  device        ESSLDevice   @relation(fields: [deviceId], references: [id])

  createdAt     DateTime     @default(now())

  @@index([deviceId])
  @@index([punchTime])
  @@index([staffId])
}

model ESSLStaffMapping {
  id            String     @id @default(uuid())
  staffId       String     @unique
  deviceId      String
  deviceUserId  String

  staff         Staff      @relation(fields: [staffId], references: [id])
  device        ESSLDevice @relation(fields: [deviceId], references: [id])

  createdAt     DateTime   @default(now())

  @@unique([deviceId, deviceUserId])
}

model ESSLSyncHistory {
  id            String      @id @default(uuid())
  deviceId      String?
  status        String      @default("success")
  recordsCount  Int         @default(0)
  error         String?
  syncedAt      DateTime    @default(now())

  device        ESSLDevice? @relation(fields: [deviceId], references: [id])
}

model Payroll {
  id                     String   @id @default(uuid())
  staffId                String
  month                  String
  basicSalary            Float    @default(0)
  hra                    Float    @default(0)
  da                     Float    @default(0)
  otherAllowances        Float    @default(0)
  grossSalary            Float    @default(0)
  totalWorkingDays       Int      @default(0)
  presentDays            Float    @default(0)
  lopDays                Float    @default(0)
  lopDeduction           Float    @default(0)
  permissionHoursUsed    Float    @default(0)
  permissionLopDays      Float    @default(0)
  permissionLopDeduction Float    @default(0)
  pfDeduction            Float    @default(0)
  esiDeduction           Float    @default(0)
  ptDeduction            Float    @default(0)
  fixedAdvanceDeduction  Float    @default(0)
  salaryAdvanceDeduction Float    @default(0)
  otherAdvanceDeduction  Float    @default(0)
  extraAllowance         Float    @default(0)
  totalDeductions        Float    @default(0)
  netSalary              Float    @default(0)
  status                 String   @default("generated")

  staff                  Staff    @relation(fields: [staffId], references: [id])

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([staffId, month])
  @@index([month])
}

// ═══════════════════════════════════════════════
// STAFF ADVANCE / LOAN TICKET SYSTEM
// ═══════════════════════════════════════════════

model StaffAdvance {
  id                String    @id @default(uuid())
  ticketNo          String    @unique         // e.g. ADV-2026-00001
  staffId           String
  type              String                    // FIXED_ADVANCE / SALARY_ADVANCE / OTHER_ADVANCE
  amount            Float                     // Total advance amount
  reason            String?
  monthlyDeduction  Float     @default(0)     // Auto-deduct per payroll
  totalRepaid       Float     @default(0)
  balanceRemaining  Float     @default(0)

  // Ticket status workflow
  status            String    @default("REQUESTED") // REQUESTED → APPROVED → DISBURSED → REPAYING → CLOSED / REJECTED
  requestedAt       DateTime  @default(now())
  approvedAt        DateTime?
  approvedByEmail   String?
  rejectedAt        DateTime?
  rejectedByEmail   String?
  rejectionReason   String?
  disbursedAt       DateTime?
  closedAt          DateTime?

  staff             Staff     @relation(fields: [staffId], references: [id])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([staffId])
  @@index([status])
}

// ═══════════════════════════════════════════════
// POS / STORE MANAGEMENT
// ═══════════════════════════════════════════════

enum ItemCategory {
  STATIONERY
  UNIFORM
  BOOKS
  SANITARY
  FURNITURE
  ID_CARD
  ACCESSORIES
  OTHER
}

// Store locations (Master Store, Stationery Shop, etc.)
model Store {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  isMaster    Boolean  @default(false) // only one master store

  stockItems      StoreStock[]
  outTransfers    StockTransfer[] @relation("TransferFrom")
  inTransfers     StockTransfer[] @relation("TransferTo")
  sales           Sale[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Master catalog of items
model StoreItem {
  id            String       @id @default(uuid())
  name          String
  sku           String?      @unique
  category      ItemCategory @default(OTHER)
  description   String?
  image         String?      // file path or URL
  unit          String       @default("pcs") // pcs, kg, box, etc.
  sellingPrice  Float        @default(0)
  costPrice     Float        @default(0)
  reorderLevel  Int          @default(5)
  isFreeEligible Boolean    @default(false) // can be given free to teachers
  freeLimit     Int          @default(0) // max free qty per teacher per year
  isActive      Boolean      @default(true)

  stockItems        StoreStock[]
  purchaseItems     PurchaseItem[]
  transferItems     StockTransferItem[]
  saleItems         SaleItem[]
  teacherFreeItems  TeacherFreeItem[]
  feeKitItems       FeeKitItem[]
  studentKitIssues  StudentKitIssue[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Stock per store per item
model StoreStock {
  id        String    @id @default(uuid())
  storeId   String
  itemId    String
  quantity  Int       @default(0)

  store     Store     @relation(fields: [storeId], references: [id])
  item      StoreItem @relation(fields: [itemId], references: [id])

  updatedAt DateTime  @updatedAt

  @@unique([storeId, itemId])
}

// Supplier / Vendor
model Supplier {
  id          String   @id @default(uuid())
  name        String
  phone       String?
  email       String?
  address     String?
  gstNo       String?
  isActive    Boolean  @default(true)

  purchases   Purchase[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Purchase from supplier
model Purchase {
  id            String   @id @default(uuid())
  supplierId    String
  storeId       String   // which store receives the goods
  invoiceNo     String?
  invoiceDate   DateTime @default(now())
  receiptImage  String?  // uploaded receipt file path
  totalAmount   Float    @default(0)
  remarks       String?

  supplier      Supplier @relation(fields: [supplierId], references: [id])
  items         PurchaseItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseItem {
  id          String    @id @default(uuid())
  purchaseId  String
  itemId      String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item        StoreItem @relation(fields: [itemId], references: [id])
}

// Stock transfer from one store to another
model StockTransfer {
  id            String   @id @default(uuid())
  fromStoreId   String
  toStoreId     String
  transferDate  DateTime @default(now())
  remarks       String?
  status        String   @default("COMPLETED") // PENDING / COMPLETED / CANCELLED

  fromStore     Store    @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStore       Store    @relation("TransferTo", fields: [toStoreId], references: [id])
  items         StockTransferItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StockTransferItem {
  id            String        @id @default(uuid())
  transferId    String
  itemId        String
  quantity      Int

  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item          StoreItem     @relation(fields: [itemId], references: [id])
}

// Sales from a store (POS transaction)
model Sale {
  id            String   @id @default(uuid())
  storeId       String
  invoiceNo     String?
  saleDate      DateTime @default(now())
  customerName  String?  // walk-in or student name
  customerType  String   @default("WALK_IN") // WALK_IN / STUDENT / STAFF
  paymentMode   String   @default("CASH") // CASH / UPI / CARD
  totalAmount   Float    @default(0)
  discount      Float    @default(0)
  netAmount     Float    @default(0)
  remarks       String?

  store         Store    @relation(fields: [storeId], references: [id])
  items         SaleItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SaleItem {
  id          String    @id @default(uuid())
  saleId      String
  itemId      String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item        StoreItem @relation(fields: [itemId], references: [id])
}

// Free items given to teachers (pencils, erasers, whiteners, etc.)
model TeacherFreeItem {
  id            String   @id @default(uuid())
  staffId       String
  itemId        String
  academicYear  String
  quantityGiven Int      @default(0)
  quantityReturned Int   @default(0)
  givenDate     DateTime @default(now())
  returnedDate  DateTime?
  status        String   @default("GIVEN") // GIVEN / RETURNED / PARTIAL_RETURNED

  staff         Staff     @relation(fields: [staffId], references: [id])
  item          StoreItem @relation(fields: [itemId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([staffId, academicYear])
}

// POS Expense / Income tracking
model PosTransaction {
  id            String   @id @default(uuid())
  type          String   // INCOME / EXPENSE
  category      String   // SALE / PURCHASE / MAINTENANCE / OTHER
  description   String
  amount        Float
  date          DateTime @default(now())
  referenceId   String?  // optional link to a Sale or Purchase id
  receiptImage  String?
  remarks       String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════════
// ─── DOCUMENT ISSUE MODULE (TC, Bonafide, etc.) ─
// ═══════════════════════════════════════════════

enum DocRequestType {
  TRANSFER_CERTIFICATE
  BONAFIDE_CERTIFICATE
  CONDUCT_CERTIFICATE
  STUDY_CERTIFICATE
  FEE_CERTIFICATE
  OTHER
}

enum DocRequestStatus {
  REQUESTED    // Staff/parent raised request
  IN_REVIEW    // Under admin/principal review
  APPROVED     // Ready for generation
  ISSUED       // PDF generated & handed out
  REJECTED     // Declined with reason
}

model DocRequest {
  id              String           @id @default(uuid())
  ticketNo        String           @unique          // e.g. DOC-2026-00001
  studentId       String
  type            DocRequestType
  status          DocRequestStatus @default(REQUESTED)
  reason          String?                           // why the document is needed
  remarks         String?                           // internal staff notes
  rejectionReason String?

  // Tracking
  requestedById   Int                               // User.id who raised the request
  requestedAt     DateTime         @default(now())
  reviewedById    Int?                              // User.id who reviewed
  reviewedAt      DateTime?
  issuedAt        DateTime?
  issuedById      Int?                              // User.id who issued/generated

  // Generated document
  pdfPath         String?                           // path to generated PDF

  // For TC: additional fields
  tcNo            String?                           // serial number for TC
  tcDate          DateTime?
  leavingReason   String?                           // reason for leaving (TC)
  conductRemark   String?          @default("Good") // conduct/character remark
  qualifiedForPromotion Boolean?                    // promoted to next class?
  dateOfLeaving   DateTime?
  lastAttendedDate DateTime?

  student         Student          @relation(fields: [studentId], references: [id])
  requestedBy     User             @relation("DocRequestedBy", fields: [requestedById], references: [id])
  reviewedBy      User?            @relation("DocReviewedBy", fields: [reviewedById], references: [id])
  issuedBy        User?            @relation("DocIssuedBy", fields: [issuedById], references: [id])

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([studentId])
  @@index([status])
  @@index([type])
}


