model Staff {
  id            String   @id @default(uuid())
  employeeId    String   @unique
  name          String
  email         String   @unique
  phone         String?
  designation   String   // e.g. "Teacher", "HOD", "Principal", "Clerk"
  department    String?  // e.g. "Mathematics", "Science", "Administration"
  qualification String?
  joiningDate   DateTime?
  salary        Float?
  isActive      Boolean  @default(true)

  // Link to children studying here (for teacher discount)
  children      Student[] @relation("StaffChildren")

  // HR relations
  attendances         Attendance[]
  leaveApplications   LeaveApplication[]
  permissionRequests  PermissionRequest[]
  staffStatutory      StaffStatutory?
  payrollRecords      Payroll[]
  esslMapping         ESSLStaffMapping?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model Driver {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  deviceId  String?
  busId     String?
  bus       Bus?     @relation(fields: [busId], references: [id])
  locations Location[]
  createdAt DateTime @default(now())
}

model Bus {
  id          String   @id @default(uuid())
  number      String   // e.g. TN-01-1234
  routeName   String?
  routeId     String?
  capacity    Int?
  drivers     Driver[]
  locations   Location[]
  route       TransportRoute? @relation("RouteBuses", fields: [routeId], references: [id])
  createdAt   DateTime @default(now())
}

model Location {
  id        String   @id @default(uuid())
  driverId  String
  busId     String
  latitude  Float
  longitude Float
  speed     Float?
  createdAt DateTime

  driver Driver @relation(fields: [driverId], references: [id])
  bus    Bus    @relation(fields: [busId], references: [id])

  @@index([driverId])
  @@index([busId])
  @@index([createdAt])

  // prevent duplicates during retry sync
  @@unique([driverId, createdAt])
}

model FeeStructure {
  id           String   @id @default(uuid())
  standard     Standard
  academicYear String

  tuitionFee   Float
  transportFee Float   @default(0)
  bookFee      Float   @default(0)
  hostelFee    Float   @default(0)
  otherFee     Float   @default(0)

  numberOfTerms Int    @default(1)  // 1, 2, or 3

  customItems  CustomFeeItem[]
  terms        FeeTermTemplate[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([standard, academicYear])
}

// Term-wise breakdown template (auto-generated from structure)
model FeeTermTemplate {
  id              String       @id @default(uuid())
  feeStructureId  String
  termNumber      Int          // 1, 2, 3
  termName        String       // "Term 1", "Term 2", etc.
  dueDate         DateTime?
  amount          Float        // portion of total for this term

  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

model StudentFee {
  id            String   @id @default(uuid())
  studentId     String
  academicYear  String

  tuitionFee    Float   @default(0)
  transportFee  Float   @default(0)
  bookFee       Float   @default(0)
  hostelFee     Float   @default(0)
  otherFee      Float   @default(0)

  totalFee      Float
  discount      Float   @default(0)
  netFee        Float

  numberOfTerms Int     @default(1)

  student       Student @relation(fields: [studentId], references: [id])
  payments      Payment[]
  discounts     Discount[]
  customItems   StudentCustomFeeItem[]
  terms         StudentFeeTerm[]
  paymentLinks  PaymentLink[]

  @@unique([studentId, academicYear])
}

// Term-wise breakdown per student
model StudentFeeTerm {
  id            String     @id @default(uuid())
  studentFeeId  String
  termNumber    Int        // 1, 2, 3
  termName      String     // "Term 1", "Term 2"
  amount        Float      // how much is due this term
  dueDate       DateTime?
  status        String     @default("PENDING") // PENDING / PARTIAL / PAID

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
}


model Payment {
  id            String   @id @default(uuid())
  studentFeeId  String

  amount        Float
  paymentDate   DateTime @default(now())
  paymentMode   String   // CASH / UPI / BANK
  receiptNo     String?
  remarks       String?
  termNumber    Int?     // which term this payment is for (null = general)
  status        String   @default("SUCCESS")
  statusReason  String?
  refundAmount  Float?
  receiptComponents Json?

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id])

  createdAt     DateTime @default(now())
}


model Discount {
  id            String       @id @default(uuid())
  studentFeeId  String

  type          DiscountType // FLAT / PERCENTAGE / TEACHER_DISCOUNT / SIBLING_DISCOUNT / RTE_COMMUNITY
  value         Float
  reason        String?

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id])
}

// Custom fee items on the FeeStructure template (e.g. Lab Fee for a standard)
model CustomFeeItem {
  id              String       @id @default(uuid())
  feeStructureId  String
  name            String       // e.g. "Lab Fee", "Sports Fee"
  amount          Float

  feeStructure    FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
}

// Custom fee items assigned to a specific student
model StudentCustomFeeItem {
  id            String     @id @default(uuid())
  studentFeeId  String
  name          String     // e.g. "Lab Fee", "Special Coaching"
  amount        Float

  studentFee    StudentFee @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════
// TRANSPORT MANAGEMENT
// ═══════════════════════════════════════════════

model TransportRoute {
  id            String   @id @default(uuid())
  routeName     String   // e.g. "Route A - Velachery"
  routeNo       String?  @unique
  baseFee       Float    // normal fee for this route
  splClassFee   Float    @default(0) // additional surcharge for special/spl class
  description   String?

  stops         TransportStop[]
  students      StudentTransport[]
  buses         Bus[]     @relation("RouteBuses")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TransportStop {
  id            String         @id @default(uuid())
  routeId       String
  stopName      String         // e.g. "Tambaram", "Chrompet"
  stopOrder     Int            // order of stop on route
  distanceKm    Float?
  pickupTime    String?        // e.g. "07:30 AM"
  dropTime      String?        // e.g. "04:15 PM"
  fee           Float?         // optional per-stop fee override

  route         TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students      StudentTransport[]
}

// Student → Route assignment
model StudentTransport {
  id            String         @id @default(uuid())
  studentId     String         @unique
  routeId       String
  stopId        String?
  academicYear  String
  isSplClass    Boolean        @default(false) // if true, charge splClassFee extra

  student       Student        @relation(fields: [studentId], references: [id])
  route         TransportRoute @relation(fields: [routeId], references: [id])
  stop          TransportStop? @relation(fields: [stopId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ═══════════════════════════════════════════════
// ─── HR MODULE ────────────────────────────────
// ═══════════════════════════════════════════════

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
  WEEK_OFF
}

enum PunchMethod {
  FINGERPRINT
  FACE
  CARD
  PIN
  MANUAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Attendance {
  id            String           @id @default(uuid())
  staffId       String
  date          DateTime         @db.Date
  status        AttendanceStatus @default(PRESENT)
  checkIn       String?
  checkOut      String?
  punchMethod   PunchMethod?
  workingHours  Float?
  remarks       String?
  isESSLSync    Boolean          @default(false)

  staff         Staff            @relation(fields: [staffId], references: [id])

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([staffId, date])
  @@index([date])
}

model LeaveType {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  maxPerYear    Int      @default(12)
  carryForward  Boolean  @default(false)
  isActive      Boolean  @default(true)

  applications  LeaveApplication[]
  balances      LeaveBalance[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LeaveBalance {
  id            String    @id @default(uuid())
  staffId       String
  leaveTypeId   String
  year          String
  total         Float     @default(0)
  used          Float     @default(0)
  remaining     Float     @default(0)

  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([staffId, leaveTypeId, year])
}

model LeaveApplication {
  id            String      @id @default(uuid())
  staffId       String
  leaveTypeId   String
  fromDate      DateTime    @db.Date
  toDate        DateTime    @db.Date
  days          Float
  halfDay       Boolean     @default(false)
  reason        String
  status        LeaveStatus @default(PENDING)
  approvedBy    String?
  rejectedBy    String?
  rejectionNote String?

  staff         Staff       @relation(fields: [staffId], references: [id])
  leaveType     LeaveType   @relation(fields: [leaveTypeId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([staffId])
  @@index([status])
}

model PermissionRequest {
  id            String      @id @default(uuid())
  staffId       String
  date          DateTime    @db.Date
  fromTime      String
  toTime        String
  hours         Float
  reason        String
  status        LeaveStatus @default(PENDING)
  approvedBy    String?
  rejectedBy    String?
  rejectionNote String?

  staff         Staff       @relation(fields: [staffId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([staffId])
  @@index([date])
}

model StatutorySettings {
  id              String   @id @default(uuid())
  pfEnabled       Boolean  @default(true)
  pfEmployeeRate  Float    @default(12)
  pfEmployerRate  Float    @default(12)
  pfWageLimit     Float    @default(15000)
  pfAdminCharges  Float    @default(0.5)
  pfEdliCharges   Float    @default(0.5)
  esiEnabled      Boolean  @default(true)
  esiEmployeeRate Float    @default(0.75)
  esiEmployerRate Float    @default(3.25)
  esiWageLimit    Float    @default(21000)
  ptEnabled       Boolean  @default(false)
  ptAmount        Float    @default(200)

  updatedAt       DateTime @updatedAt
}

model StaffStatutory {
  id            String   @id @default(uuid())
  staffId       String   @unique
  pfNumber      String?
  uanNumber     String?
  esiNumber     String?
  basicSalary   Float?
  grossSalary   Float?
  pfEnabled     Boolean  @default(true)
  esiEnabled    Boolean  @default(true)

  staff         Staff    @relation(fields: [staffId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ESSLDevice {
  id            String   @id @default(uuid())
  name          String
  ipAddress     String
  port          Int      @default(4370)
  serialNumber  String?
  deviceType    String   @default("fingerprint")
  location      String?
  isOnline      Boolean  @default(false)
  lastSyncAt    DateTime?

  punchLogs     ESSLPunchLog[]
  staffMappings ESSLStaffMapping[]
  syncHistory   ESSLSyncHistory[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ESSLPunchLog {
  id            String       @id @default(uuid())
  deviceId      String
  staffId       String?
  employeeId    String?
  punchTime     DateTime
  punchType     String?
  punchMethod   PunchMethod?
  verified      Boolean      @default(true)

  device        ESSLDevice   @relation(fields: [deviceId], references: [id])

  createdAt     DateTime     @default(now())

  @@index([deviceId])
  @@index([punchTime])
  @@index([staffId])
}

model ESSLStaffMapping {
  id            String     @id @default(uuid())
  staffId       String     @unique
  deviceId      String
  deviceUserId  String

  staff         Staff      @relation(fields: [staffId], references: [id])
  device        ESSLDevice @relation(fields: [deviceId], references: [id])

  createdAt     DateTime   @default(now())

  @@unique([deviceId, deviceUserId])
}

model ESSLSyncHistory {
  id            String      @id @default(uuid())
  deviceId      String?
  status        String      @default("success")
  recordsCount  Int         @default(0)
  error         String?
  syncedAt      DateTime    @default(now())

  device        ESSLDevice? @relation(fields: [deviceId], references: [id])
}

model Payroll {
  id                     String   @id @default(uuid())
  staffId                String
  month                  String
  basicSalary            Float    @default(0)
  hra                    Float    @default(0)
  da                     Float    @default(0)
  otherAllowances        Float    @default(0)
  grossSalary            Float    @default(0)
  totalWorkingDays       Int      @default(0)
  presentDays            Float    @default(0)
  lopDays                Float    @default(0)
  lopDeduction           Float    @default(0)
  permissionHoursUsed    Float    @default(0)
  permissionLopDays      Float    @default(0)
  permissionLopDeduction Float    @default(0)
  pfDeduction            Float    @default(0)
  esiDeduction           Float    @default(0)
  ptDeduction            Float    @default(0)
  totalDeductions        Float    @default(0)
  netSalary              Float    @default(0)
  status                 String   @default("generated")

  staff                  Staff    @relation(fields: [staffId], references: [id])

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([staffId, month])
  @@index([month])
}