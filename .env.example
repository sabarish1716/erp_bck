# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:LlOUCmf1tYEYrDKg@localhost:5432/nestdb"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-here

# ─── School ─────────────────────────────────────────────────────────────────
SCHOOL_NAME="My School"

# ─── PhonePe Payment Gateway ────────────────────────────────────────────────
# Get from PhonePe merchant dashboard: https://business.phonepe.com
#
# Sandbox (UAT) defaults are pre-filled below for testing.
# Replace with PRODUCTION credentials before going live.
#
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1

# Sandbox URL (change to production URL when ready):
#   Production: https://api.phonepe.com/apis/hermes
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Your backend's public URL (PhonePe will POST the webhook here)
PHONEPE_CALLBACK_URL=https://your-backend.example.com

# Frontend URL (where to redirect after payment completes)
PHONEPE_REDIRECT_URL=https://your-frontend.example.com

# ─── SMS Provider ────────────────────────────────────────────────────────────
# Supported: fast2sms | msg91   (default: fast2sms)
SMS_PROVIDER=fast2sms

# Fast2SMS — https://www.fast2sms.com  (popular for Indian schools)
FAST2SMS_API_KEY=your-fast2sms-api-key

# MSG91 — https://msg91.com  (alternative SMS/WhatsApp provider)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-msg91-flow-template-id

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
# Get from: https://console.twilio.com
# Sandbox WhatsApp from number: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Live Location / Geofencing ─────────────────────────────────────────────
# School geofence center used by /location/live/drivers
SCHOOL_GEOFENCE_LAT=13.0827
SCHOOL_GEOFENCE_LNG=80.2707
SCHOOL_GEOFENCE_RADIUS_M=250
